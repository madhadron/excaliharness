{
  "name": "excaliharness",
  "displayName": "Excaliharness",
  "description": "madhadron's agentic coding harness - state in watched Markdown files, hyperlinks everywhere, human review prioritized.",
  "version": "0.0.1",
  "publisher": "madhadron",
  "private": true,
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:TASKS.md"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc && tsc -p src/test",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:vscode": "node esbuild.mjs && xvfb-run -a vscode-test",
    "package": "node esbuild.mjs && vsce package --skip-license --allow-missing-repository --no-rewrite-relative-links --out dist/"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.137.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
