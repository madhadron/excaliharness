{
  "name": "excaliharness",
  "displayName": "Excaliharness",
  "description": "madhadron's agentic coding harness - state in watched Markdown files, hyperlinks everywhere, human review prioritized.",
  "version": "0.0.1",
  "publisher": "madhadron",
  "private": true,
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace Excaliharness starts no worker and offers no commands; it only opens the diff of a task review it opened that workspace for."
    }
  },
  "activationEvents": [
    "workspaceContains:TASKS.md"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "excaliharness.signIn",
        "title": "Sign In to Claude",
        "category": "Excaliharness"
      },
      {
        "command": "excaliharness.signOut",
        "title": "Sign Out of Claude",
        "category": "Excaliharness"
      },
      {
        "command": "excaliharness.claudeAccount",
        "title": "Claude Account",
        "category": "Excaliharness"
      },
      {
        "command": "excaliharness.markReady",
        "title": "Mark Task Ready",
        "category": "Excaliharness"
      },
      {
        "command": "excaliharness.markDone",
        "title": "Mark Task Done",
        "category": "Excaliharness"
      },
      {
        "command": "excaliharness.backToDraft",
        "title": "Move Task Back to Draft",
        "category": "Excaliharness"
      },
      {
        "command": "excaliharness.restartWorker",
        "title": "Restart Worker",
        "category": "Excaliharness"
      },
      {
        "command": "excaliharness.openTaskAt",
        "title": "Open Task at Line",
        "category": "Excaliharness"
      },
      {
        "command": "excaliharness.openReview",
        "title": "Open Task Review",
        "category": "Excaliharness"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "excaliharness.markReady",
          "when": "excaliharness.active && resourcePath =~ /[\\\\/]tasks[\\\\/]T-[0-9]+\\.md$/"
        },
        {
          "command": "excaliharness.markDone",
          "when": "excaliharness.active && resourcePath =~ /[\\\\/]tasks[\\\\/]T-[0-9]+\\.md$/"
        },
        {
          "command": "excaliharness.restartWorker",
          "when": "excaliharness.active"
        },
        {
          "command": "excaliharness.signIn",
          "when": "excaliharness.active"
        },
        {
          "command": "excaliharness.signOut",
          "when": "excaliharness.active && excaliharness.signedIn"
        },
        {
          "command": "excaliharness.claudeAccount",
          "when": "false"
        },
        {
          "command": "excaliharness.backToDraft",
          "when": "excaliharness.active && resourcePath =~ /[\\\\/]tasks[\\\\/]T-[0-9]+\\.md$/"
        },
        {
          "command": "excaliharness.openTaskAt",
          "when": "false"
        },
        {
          "command": "excaliharness.openReview",
          "when": "excaliharness.active && resourcePath =~ /[\\\\/]tasks[\\\\/]T-[0-9]+\\.md$/"
        }
      ]
    },
    "configuration": {
      "title": "Excaliharness",
      "properties": {
        "excaliharness.maxParallelTasks": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 16,
          "description": "How many tasks the orchestrator runs at once (D-074)."
        },
        "excaliharness.speakNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Speak task notifications (ready for review, needs you, has a question) through macOS `say` (D-084)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc && tsc -p src/test",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:vscode": "node esbuild.mjs && rm -rf .vscode-test/workspace && cp -r src/test/fixtures/workspace .vscode-test/workspace && rm -rf .vscode-test/workspace/.excaliharness && xvfb-run -a vscode-test",
    "package": "node esbuild.mjs && vsce package --skip-license --allow-missing-repository --no-rewrite-relative-links --out dist/"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.137.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
